# Real values: `uv run python scripts/make_env.py` (read-only lookup with your AWS login)
RF_REGION=ap-northeast-2
RF_TABLE=receipt-flow-dev
RF_BUCKET=
RF_QUEUE_URL=
# cognito | dev (dev accepts "Bearer dev:<sub>:<employee|reviewer>:<name>")
RF_AUTH_MODE=cognito
RF_COGNITO_POOL_ID=
RF_COGNITO_CLIENT_ID=
# bedrock | mock (mock returns a fixed receipt; no AI cost)
RF_AI_MODE=bedrock
# 영수증 사진 분석 / 챗봇 답변 정리 (docs/model-eval.md)
RF_EXTRACT_MODEL=global.anthropic.claude-sonnet-5-5
RF_CHAT_MODEL=global.anthropic.claude-haiku-5-5
RF_CORS_ORIGINS=http://localhost:5173
AWS_PROFILE=team-admin
# Local only: also accept the developer-login test accounts next to Cognito (never in deploy).
RF_DEV_LOGIN=false
# Optional: landing-page cost card (AWS Budgets budget name and card label; defaults shown)
# RF_USAGE_BUDGET=aws-team4-receipt-flow
# RF_USAGE_LABEL=AWS 클라우드 4조
